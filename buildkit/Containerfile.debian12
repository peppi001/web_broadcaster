FROM docker.io/library/debian:12-slim

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        binutils \
        ca-certificates \
        coreutils \
        file \
        findutils \
        gawk \
        grep \
        sed \
        tar \
        unzip \
        python3 \
        python3-venv \
        libpython3.11 \
        ffmpeg \
        nodejs \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /work
